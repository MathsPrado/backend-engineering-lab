@page "/post/{Slug}"
@using Blog.Web.Models
@using Blog.Web.Services
@inject FileSystemPostRepository PostRepository
@inject MarkdownService MarkdownService
@inject IJSRuntime JSRuntime

@if (_post != null)
{
    <PageTitle>@_post.Title - Laboratório de Estudos em .NET</PageTitle>

    <div class="container py-4">
        <!-- Breadcrumb & Botão Voltar -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a href="/">Início</a></li>
                <li class="breadcrumb-item"><a href="/?category=@_post.Category">@_post.Category</a></li>
                <li class="breadcrumb-item active" aria-current="page">@_post.Subcategory</li>
            </ol>
        </nav>

        <div class="mb-4 d-flex justify-content-between align-items-center">
            <a href="/" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar ao Feed
            </a>
            <span class="text-secondary small">
                <i class="bi bi-clock-history me-1"></i> Última modificação: @_post.LastModified.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <!-- Cabeçalho do Artigo -->
        <div class="mb-4 border-bottom border-secondary pb-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge badge-module">@_post.Category</span>
                <span class="badge badge-submodule">@_post.Subcategory</span>
            </div>
            <h1 class="display-5 text-light fw-bold">@_post.Title</h1>
        </div>

        <!-- Conteúdo Renderizado em HTML do Markdown -->
        <article class="markdown-article shadow-lg">
            @((MarkupString)_renderedHtml)
        </article>

        <!-- Botão Voltar no Rodapé do Artigo -->
        <div class="mt-5 text-center">
            <a href="/" class="btn btn-info rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Voltar para a lista de estudos
            </a>
        </div>
    </div>
}
else if (_notFound)
{
    <div class="container py-5 text-center">
        <div class="alert alert-danger bg-slate-800 border-danger text-light py-5">
            <i class="bi bi-exclamation-triangle fs-1 text-danger d-block mb-3"></i>
            <h3 class="fw-bold">Estudo não encontrado</h3>
            <p class="text-secondary">O caminho ou slug do artigo especificado não foi localizado no repositório.</p>
            <a href="/" class="btn btn-primary rounded-pill px-4 mt-3">Voltar ao Início</a>
        </div>
    </div>
}
else
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Carregando estudo...</span>
        </div>
        <p class="text-secondary mt-3">Renderizando artigo...</p>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private BlogPost? _post;
    private string _renderedHtml = string.Empty;
    private bool _notFound = false;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        _post = await PostRepository.GetPostBySlugAsync(Slug);

        if (_post != null)
        {
            _renderedHtml = MarkdownService.ToHtml(_post.ContentMarkdown);
        }
        else
        {
            _notFound = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_post != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("highlightAllCode");
            }
            catch
            {
                // Ignora falhas em pré-renderização estática
            }
        }
    }
}
