@inherits LayoutComponentBase

<div class="min-vh-100 d-flex flex-column bg-dark text-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" href="/">
                <span class="fs-3">🚀</span>
                <span>Laboratório .NET Estudos</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-2">
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="/" Match="NavLinkMatch.All">
                            <i class="bi bi-house-door me-1"></i> Início / Feed
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="https://github.com/MathsPrado/backend-engineering-lab" target="_blank" rel="noopener">
                            <i class="bi bi-github me-1"></i> Repositório Git
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-secondary text-center py-4 border-top border-secondary mt-5">
        <div class="container">
            <p class="mb-1 text-slate-400">🚀 <strong>Laboratório .NET Estudos</strong> — Portal de Estudos & Roteiros de Performance em C# / .NET 10</p>
            <small class="text-muted">Desenvolvido com Blazor Server • Leitura nativa do FileSystem sem banco de dados</small>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
